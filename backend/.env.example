# ==============================================================================
# Database Configuration
# ==============================================================================
DATABASE_TYPE=postgres
DATABASE_URL=jdbc:postgresql://<host>/<database>?sslmode=require&channelBinding=require
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password
DATABASE_DRIVER_CLASS_NAME=org.postgresql.Driver

# ==============================================================================
# Cache Configuration
# Negative Caching (Invalid API Keys - Protection against Cache Penetration)
# ==============================================================================
HOOKFLOW_CACHE_NEGATIVE_TTL_SECONDS=30

# L1 Cache (In-Memory Caffeine)
HOOKFLOW_CACHE_L1_MAX_SIZE=1000
HOOKFLOW_CACHE_L1_TTL_SECONDS=120

# L2 Cache (Distributed Redis)
HOOKFLOW_CACHE_L2_ENABLED=false
HOOKFLOW_CACHE_L2_TTL_SECONDS=300
HOOKFLOW_CACHE_L2_PREFIX=hookflow:apikey:

# ==============================================================================
# Redis Connection (Required when HOOKFLOW_CACHE_L2_ENABLED=true or HOOKFLOW_QUEUE_TYPE=redis)
# ==============================================================================
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# ==============================================================================
# Queue Configuration (Queue Adapter: sqs | redis | rabbitmq)
# ==============================================================================
HOOKFLOW_QUEUE_TYPE=sqs
HOOKFLOW_QUEUE_NAME=hookflow-events

# Queue Retry Configuration
HOOKFLOW_QUEUE_RETRY_MAX_ATTEMPTS=3
HOOKFLOW_QUEUE_RETRY_INITIAL_DELAY_MS=500
HOOKFLOW_QUEUE_RETRY_MULTIPLIER=2.0
HOOKFLOW_QUEUE_RETRY_MAX_DELAY_MS=5000

# AWS SQS Configuration (Required when HOOKFLOW_QUEUE_TYPE=sqs)
HOOKFLOW_QUEUE_SQS_REGION=us-east-1
HOOKFLOW_QUEUE_SQS_ENDPOINT=
HOOKFLOW_QUEUE_SQS_QUEUE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
